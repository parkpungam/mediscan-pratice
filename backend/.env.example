# Local PostgreSQL connection. Copy to .env and provide your local password there.
PGHOST=localhost
PGPORT=5432
PGDATABASE=mediscan_note
PGUSER=postgres
PGPASSWORD=
FRONTEND_ORIGIN=http://localhost:8080

# Development-only authentication shortcut. Never enable this in production.
ENVIRONMENT=development
ENABLE_DEV_AUTH_SHORTCUTS=false